{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["bun-types"],
    "lib": ["ESNext"],
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  },
  "include": ["index.tsx", "src/**/*.tsx", "src/**/*.ts"]
}
